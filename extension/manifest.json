{
  "name": "HS Nav",
  "description": "Quickly navigate within HubSpot.",
  "version": "2.0.0",
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "permissions": [
    "storage"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.hubspot.com/*"],
      "js": ["contentScript.js"]
    }
  ],
  "commands": {
    "open_search_bar": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open HS Nav"
    }
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Open HS Nav"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://*.hubspot.com/*"
  ]
}
